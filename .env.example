# permit-mcp configuration. The server does NOT load this file by itself: pass it with
# `uv run --env-file .env permit-mcp`, or put the values in your MCP client's `env` block.
# Empty values count as unset. See the Configuration section of README.md.

# Required. An environment-level Permit API key; the project and environment come from it.
PERMIT_API_KEY=
# Required. Key of the resource type the tools manage, such as documents.
PERMIT_RESOURCE=
# Required by the permit-mcp command. Key of the Permit user every tool call acts as.
PERMIT_MCP_USER=

# Set at least one. ID or key of the User Management element (access-request tools)
# and of the Approval Management element (operation-approval tools).
PERMIT_ACCESS_REQUEST_ELEMENT=
PERMIT_OPERATION_APPROVAL_ELEMENT=

# Optional. Defaults: default, https://api.permit.io, https://cloudpdp.api.permit.io
PERMIT_TENANT=
PERMIT_API_URL=
PERMIT_PDP_URL=
