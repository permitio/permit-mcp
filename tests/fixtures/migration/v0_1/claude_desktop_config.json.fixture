{
  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "/ABSOLUTE/PATH/TO/menus"]
    },
    "permit": {
      "command": "uv",
      "args": [
        "--directory",
        "/ABSOLUTE/PATH/TO/permit-mcp/src/permit_mcp",
        "run",
        "server.py"
      ],
      "env": {
        "TENANT": "default"
      }
    }
  }
}
