    "list_access_requests": {
      "annotations": {
        "openWorldHint": false,
        "readOnlyHint": true
      },
      "description": "List the access requests of this server's access request element that Permit shows the acting user, each with the requesting user's email and name. Acts as the caller's Permit user.",
      "input_schema": {
        "properties": {
          "page": {
            "default": 1,
            "description": "Page number of the results, starting at 1.",
            "minimum": 1,
            "title": "Page",
            "type": "integer"
          },
          "per_page": {
            "default": 30,
            "description": "Results per page, from 1 to 100.",
            "maximum": 100,
            "minimum": 1,
            "title": "Per Page",
            "type": "integer"
          },
          "resource_instance": {
            "anyOf": [
              {
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Only requests on this resource instance (key or ID).",
            "title": "Resource Instance"
          },
          "role": {
            "anyOf": [
              {
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Only requests for this role key.",
            "title": "Role"
          },
          "status": {
            "anyOf": [
              {
                "enum": [
                  "pending",
                  "approved",
                  "denied",
                  "canceled"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Only requests in this status.",
            "title": "Status"
          }
        },
        "title": "_list_access_requestsArguments",
        "type": "object"
      },
      "output_schema": {
        "additionalProperties": true,
        "description": "What list_access_requests and list_operation_approvals return.",
        "properties": {
          "data": {
            "description": "The requests as Permit returns them. Each holds the requesting user's email and name in requesting_user_email, requesting_user_first_name and requesting_user_last_name.",
            "items": {},
            "title": "Data",
            "type": "array"
          }
        },
        "required": [
          "data"
        ],
        "title": "RequestPage",
        "type": "object"
      }
