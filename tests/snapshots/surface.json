    "check_permission": {
      "annotations": {
        "openWorldHint": false,
        "readOnlyHint": true
      },
      "description": "Ask Permit whether the acting user may perform an action on the 'documents' resource type in tenant 'acme', or on one instance of it (the instance key, not the ID). Returns allowed: true or false. On the cloud PDP, RBAC and ReBAC policies are evaluated; a permission that only an ABAC policy grants comes back false. Asks as the caller's Permit user.",
      "input_schema": {
        "properties": {
          "action": {
            "description": "Key of the action, such as read or edit.",
            "minLength": 1,
            "title": "Action",
            "type": "string"
          },
          "resource_instance": {
            "anyOf": [
              {
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Instance key (not the ID). Optional; without it the check is on the resource type.",
            "title": "Resource Instance"
          }
        },
        "required": [
          "action"
        ],
        "title": "_check_permissionArguments",
        "type": "object"
      },
      "output_schema": {
        "description": "What check_permission returns.",
        "properties": {
          "allowed": {
            "description": "Whether the acting user may do it.",
            "title": "Allowed",
            "type": "boolean"
          }
        },
        "required": [
          "allowed"
        ],
        "title": "PermissionResult",
        "type": "object"
      }
    },
    "create_access_request": {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false,
        "readOnlyHint": false
      },
      "description": "Request a role on the 'documents' resource type in tenant 'acme', or on one instance of it. The request is filed for the acting user and waits for a reviewer to approve or deny it. Acts as the caller's Permit user.",
