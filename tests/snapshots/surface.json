  "tools": {
    "approve_access_request": {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false,
        "readOnlyHint": false
      },
      "description": "Approve an access request, which grants the requested role. Permit refuses when the acting user may not review access requests. Acts as the caller's Permit user.",
      "input_schema": {
        "properties": {
          "access_request_id": {
            "description": "ID (a UUID) of the access request, from list_access_requests.",
            "format": "uuid",
            "title": "Access Request Id",
            "type": "string"
          },
          "reviewer_comment": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Stored with the decision.",
            "title": "Reviewer Comment"
          }
        },
        "required": [
          "access_request_id"
        ],
        "title": "_approve_access_requestArguments",
        "type": "object"
      },
      "output_schema": {
        "description": "What approve_access_request returns.",
        "properties": {
          "access_request": {
            "description": "The access request, as Permit returns it.",
            "title": "Access Request"
          },
          "status": {
            "const": "approved",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "access_request"
        ],
        "title": "AccessRequestApproved",
        "type": "object"
      }
    },
