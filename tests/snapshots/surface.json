            "anyOf": [
              {
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Key or ID of one instance of the resource type. Optional. If Permit answers that an instance is required, get one from list_resource_instances.",
            "title": "Resource Instance"
          },
          "role": {
            "description": "Key of the role to request.",
            "minLength": 1,
            "title": "Role",
            "type": "string"
          }
        },
        "required": [
          "role",
          "reason"
